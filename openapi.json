{
  "openapi": "3.0.3",
  "info": {
    "title": "Ahref Service",
    "version": "1.0.0",
    "description": "Domain-keyed cache of Ahrefs domain authority and traffic data. Keyed per domain (www folded to apex, other subdomains distinct); no outlet/campaign/brand coupling."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [],
  "components": {
    "schemas": {
      "AhrefDataType": {
        "type": "string",
        "enum": [
          "authority",
          "traffic"
        ]
      },
      "UpdateDomainRatingBody": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "dataType": {
            "$ref": "#/components/schemas/AhrefDataType"
          },
          "dataCapturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "urlInput": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "rawData": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            }
          },
          "authorityDomainRating": {
            "type": "integer",
            "nullable": true
          },
          "authorityUrlRating": {
            "type": "integer",
            "nullable": true
          },
          "authorityBacklinks": {
            "type": "integer",
            "nullable": true
          },
          "authorityRefdomains": {
            "type": "integer",
            "nullable": true
          },
          "authorityDofollowBacklinks": {
            "type": "integer",
            "nullable": true
          },
          "authorityDofollowRefdomains": {
            "type": "integer",
            "nullable": true
          },
          "trafficMonthlyAvg": {
            "type": "integer",
            "nullable": true
          },
          "costMonthlyAvg": {
            "type": "number",
            "nullable": true
          },
          "trafficHistory": {
            "nullable": true
          },
          "trafficTopPages": {
            "nullable": true
          },
          "trafficTopCountries": {
            "nullable": true
          },
          "trafficTopKeywords": {
            "nullable": true
          },
          "overallSearchTraffic": {
            "type": "number",
            "nullable": true
          },
          "overallSearchTrafficHistory": {
            "nullable": true
          },
          "overallSearchTrafficValue": {
            "type": "number",
            "nullable": true
          },
          "overallSearchTrafficValueHistory": {
            "nullable": true
          },
          "overallSearchTrafficByCountry": {
            "nullable": true
          },
          "trafficByCountry": {
            "nullable": true
          },
          "overallSearchTrafficKeywords": {
            "nullable": true
          }
        },
        "required": [
          "domain",
          "dataType",
          "dataCapturedAt",
          "rawData"
        ]
      },
      "DrComputeBody": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Domains to fetch DR for. Normalized server-side (www stripped, case-folded); other subdomains kept distinct."
          }
        },
        "required": [
          "domains"
        ]
      },
      "DrStatusResponse": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "drToUpdate": {
            "type": "boolean"
          },
          "drUpdateReason": {
            "type": "string",
            "nullable": true
          },
          "drLatestSearchDate": {
            "type": "string",
            "nullable": true
          },
          "latestValidDr": {
            "type": "integer",
            "nullable": true
          },
          "latestValidDrDate": {
            "type": "string",
            "nullable": true
          },
          "needsUpdate": {
            "type": "boolean"
          }
        },
        "required": [
          "domain",
          "drToUpdate",
          "drUpdateReason",
          "drLatestSearchDate",
          "latestValidDr",
          "latestValidDrDate",
          "needsUpdate"
        ]
      },
      "LowDrResponse": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "drToUpdate": {
            "type": "boolean"
          },
          "drUpdateReason": {
            "type": "string",
            "nullable": true
          },
          "drLatestSearchDate": {
            "type": "string",
            "nullable": true
          },
          "latestValidDr": {
            "type": "integer",
            "nullable": true
          },
          "latestValidDrDate": {
            "type": "string",
            "nullable": true
          },
          "needsUpdate": {
            "type": "boolean"
          },
          "hasLowDomainRating": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "domain",
          "drToUpdate",
          "drUpdateReason",
          "drLatestSearchDate",
          "latestValidDr",
          "latestValidDrDate",
          "needsUpdate",
          "hasLowDomainRating"
        ]
      },
      "TrafficComputeBody": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "description": "Domains to fetch traffic for. Normalized server-side (www stripped, case-folded); other subdomains kept distinct."
          }
        },
        "required": [
          "domains"
        ]
      },
      "TrafficMonthly": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "description": "First day of the month (YYYY-MM-DD)."
          },
          "organicTraffic": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "month",
          "organicTraffic"
        ]
      },
      "TrafficResponse": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "hasData": {
            "type": "boolean"
          },
          "latestDataCapturedAt": {
            "type": "string",
            "nullable": true
          },
          "trafficMonthlyAvg": {
            "type": "integer",
            "nullable": true
          },
          "trafficValueMonthlyAvg": {
            "type": "integer",
            "nullable": true
          },
          "topPages": {
            "nullable": true
          },
          "topCountries": {
            "nullable": true
          },
          "topKeywords": {
            "nullable": true
          },
          "monthlyOrganicTraffic": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrafficMonthly"
            }
          },
          "trafficImplausible": {
            "type": "boolean",
            "description": "True when the latest scrape was rejected as partial/wrong-scope (a tiny, untrustworthy figure). The value fields are nulled and the series emptied; the domain is re-scraped on a later request."
          },
          "trafficImplausibleReason": {
            "type": "string",
            "nullable": true,
            "description": "Why the latest scrape was rejected, or null when trustworthy."
          }
        },
        "required": [
          "domain",
          "hasData",
          "latestDataCapturedAt",
          "trafficMonthlyAvg",
          "trafficValueMonthlyAvg",
          "monthlyOrganicTraffic",
          "trafficImplausible",
          "trafficImplausibleReason"
        ]
      },
      "AiVisibilityBody": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1,
            "description": "Brand domain to fetch Ahrefs Brand-Radar AI-visibility stats for. Normalized server-side (www stripped, case-folded)."
          }
        },
        "required": [
          "domain"
        ]
      },
      "AiVisibilityResponse": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "snapshotDate": {
            "type": "string",
            "nullable": true,
            "description": "Date the AI-visibility data reflects (extraction date)."
          },
          "fetchedFromCache": {
            "type": "boolean"
          },
          "mentionsTotal": {
            "type": "integer",
            "description": "Global brand mentions across all AI engines."
          },
          "mentionsByEngine": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "engine": {
                  "type": "string",
                  "description": "Lower-snake-case stable engine key."
                },
                "mentions": {
                  "type": "integer"
                }
              },
              "required": [
                "engine",
                "mentions"
              ]
            }
          },
          "topCompetitors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "brandId": {
                  "type": "string",
                  "description": "Global brand-service brand id."
                },
                "brand": {
                  "type": "string",
                  "nullable": true
                },
                "domain": {
                  "type": "string",
                  "nullable": true
                },
                "citations": {
                  "type": "integer"
                }
              },
              "required": [
                "brandId",
                "brand",
                "domain",
                "citations"
              ]
            }
          },
          "raw": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            },
            "description": "Full upstream Brand-Radar payload."
          }
        },
        "required": [
          "domain",
          "snapshotDate",
          "fetchedFromCache",
          "mentionsTotal",
          "mentionsByEngine",
          "topCompetitors",
          "raw"
        ]
      },
      "AiVisibilityCachedResponse": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string"
          },
          "snapshotDate": {
            "type": "string",
            "nullable": true,
            "description": "Date the cached AI-visibility data reflects (extraction date); null when nothing is cached yet."
          },
          "mentionsTotal": {
            "type": "integer",
            "description": "Global brand mentions across all AI engines (0 when uncached)."
          },
          "mentionsByEngine": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "engine": {
                  "type": "string",
                  "description": "Lower-snake-case stable engine key."
                },
                "mentions": {
                  "type": "integer"
                }
              },
              "required": [
                "engine",
                "mentions"
              ]
            }
          },
          "topCompetitors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "brandId": {
                  "type": "string",
                  "description": "Global brand-service brand id."
                },
                "brand": {
                  "type": "string",
                  "nullable": true
                },
                "domain": {
                  "type": "string",
                  "nullable": true
                },
                "citations": {
                  "type": "integer"
                }
              },
              "required": [
                "brandId",
                "brand",
                "domain",
                "citations"
              ]
            }
          }
        },
        "required": [
          "domain",
          "snapshotDate",
          "mentionsTotal",
          "mentionsByEngine",
          "topCompetitors"
        ]
      }
    },
    "parameters": {},
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "service": {
                      "type": "string",
                      "enum": [
                        "ahref-service"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "service"
                  ]
                }
              }
            }
          }
        }
      }
    },
