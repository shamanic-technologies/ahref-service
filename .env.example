PORT=3000
AHREF_SERVICE_DATABASE_URL=postgresql://user:password@localhost:5432/ahref_service
AHREF_SERVICE_API_KEY=your-api-key-here

# Downstream services — required by POST /orgs/domains/dr-compute (Apify scrape
# + run/cost/authorize). The read-only endpoints do not need these.
# The Apify token itself is NOT an env var — it is resolved at runtime from
# key-service as the platform "apify" key.
RUNS_SERVICE_URL=http://localhost:3001
RUNS_SERVICE_API_KEY=your-api-key-here
BILLING_SERVICE_URL=http://localhost:3002
BILLING_SERVICE_API_KEY=your-api-key-here
KEY_SERVICE_URL=http://localhost:3003
KEY_SERVICE_API_KEY=your-api-key-here

# brand-service — required by POST /orgs/domains/ai-visibility only (resolve
# competitor domains to global brandIds via the internal resolve-by-domain
# endpoint; no org claim, no scrape).
BRAND_SERVICE_URL=http://localhost:3004
BRAND_SERVICE_API_KEY=your-api-key-here
